# Settings of the DR11 south blind run on the CC-IN2P3 cluster (https://doc.cc.in2p3.fr).
# Activate the Python environment that has rema, then source this file before the driver:
#
#   source $HOME/software/rema-jax/scripts/slurm/ccin2p3.env
#   $REMA/scripts/slurm/rema_dr11_blind.sh prepare
#
# Jobs inherit the submitting shell's environment (sbatch --export=ALL), including the active
# Python environment. Variables already set are kept, so any of them can be overridden by
# exporting it before sourcing this file.

export REMA=${REMA:-$HOME/software/rema-jax}

# Inputs: the Legacy Surveys copy on /sps (sweeps, photo-z sweeps, randoms files 0 to 3).
export LEGACYSURVEY_DIR=${LEGACYSURVEY_DIR:-/sps/lsst/datasets/desi/legacysurveys}
export DR11=${DR11:-$LEGACYSURVEY_DIR/dr11/south}
export NRAND=${NRAND:-4}

# Work directory (galaxy tables, randoms index, regions, logs, JAX cache), one per calibration
# and rema version.
export OUTDIR=${OUTDIR:-/sps/lsst/users/$USER/rema_dr11}

# $HOME is small: keep the caches (pip, matplotlib, ...) out of it. The JAX compilation cache is
# in $OUTDIR/jax_cache, and each region task deletes its checkpoint once its catalogue is written.
export XDG_CACHE_HOME=${XDG_CACHE_HOME:-/sps/lsst/users/$USER/.cache}
export MPLCONFIGDIR=${MPLCONFIGDIR:-$XDG_CACHE_HOME/matplotlib}
export PIP_CACHE_DIR=${PIP_CACHE_DIR:-$XDG_CACHE_HOME/pip}

# Merged products, next to sweep/11.0 and sweep/11.0-photo-z.
export CLUSTERS_DIR=${CLUSTERS_DIR:-$DR11/sweep/11.0-rm}
export MEMBERS_DIR=${MEMBERS_DIR:-$DR11/sweep/11.0-rm-mem}

# Partitions: htc for the CPU stages (at most 150G per job, 7 days), V100 GPUs for the regions.
# GPUs are requested with --gpus (the cluster rejects --gres), with at most 5 CPUs per V100 and
# 12 per H100. A V100 node has 24 CPUs, 191 GB and 4 GPUs: 5 CPUs and 45G per region task let
# four tasks share a node (a region peaks at about 2.4 kB per galaxy).
# For the H100 nodes: PART_GPU=gpu_h100 REGION_CPUS=12 REGION_MEM=96G. ACCOUNT defaults to the
# main group.
export PART_CPU=${PART_CPU:-htc}
export PART_GPU=${PART_GPU:-gpu_v100}
export GPUS=${GPUS:-1}
export REGION_CPUS=${REGION_CPUS:-5}
export REGION_MEM=${REGION_MEM:-45G}

# Login and CPU nodes have no GPU: commands run there stay on the CPU instead of failing to
# initialise CUDA (the task script sets the platform of each stage itself).
export JAX_PLATFORMS=${JAX_PLATFORMS:-cpu}

# Every job reads or writes /sps, which must be declared.
case " ${EXTRA_SBATCH:-} " in
  *" --licenses=sps "*) ;;
  *) export EXTRA_SBATCH="${EXTRA_SBATCH:+$EXTRA_SBATCH }--licenses=sps" ;;
esac
